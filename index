  return `<div class="pcard" data-p="${esc(p.name)}">
    <div class="ptop"><div class="av">${initials(p.name)}</div>
      <div style="min-width:0"><div class="pname">${esc(p.name)}</div><div class="prole">${esc(p.role)}</div></div>
