<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>لوحة متابعة فرق العمل الداخلية — أجندة اللامركزية 2026</title>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{--navy:#0d2137;--navy2:#123152;--ink:#0f2035;--muted:#6b7f96;--gold:#c8a24a;--gold-soft:#f3e9d2;
--bg:#f4f6f9;--card:#fff;--line:#e2e8f0;--run:#0f9d76;--run-bg:#e6f6f1;--stuck:#d64550;--stuck-bg:#fdeaec;--upd:#e08c00;--upd-bg:#fdf3e0;--frz:#64748b;--frz-bg:#eef2f6;--dfr:#9a6b3f;--dfr-bg:#f7efe6;--obs:#94a3b8;--obs-bg:#f1f5f9;}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'IBM Plex Sans Arabic',system-ui,sans-serif;background:var(--bg);color:var(--ink);line-height:1.7;padding-bottom:60px}
.wrap{max-width:1300px;margin:0 auto;padding:0 20px}
header{background:linear-gradient(135deg,var(--navy),var(--navy2));color:#fff;padding:26px 0 22px;position:relative;overflow:hidden}
header::after{content:"";position:absolute;inset-inline-start:-80px;top:-80px;width:320px;height:320px;border-radius:50%;background:rgba(200,162,74,.1)}
.brand{display:flex;align-items:center;gap:14px;position:relative;z-index:1}
.seal{width:48px;height:48px;border-radius:12px;background:var(--gold);color:var(--navy);display:grid;place-items:center;font-weight:700;font-size:12px;text-align:center;line-height:1.25;flex-shrink:0}
h1{font-size:21px;font-weight:700}
.sub{font-size:13px;color:#a9c2da;font-weight:300}
.hdr-meta{margin-top:15px;display:flex;flex-wrap:wrap;gap:8px;position:relative;z-index:1}
.chip-meta{background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.16);padding:4px 12px;border-radius:20px;font-size:12px;color:#dce8f2}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(178px,1fr));gap:14px;margin-top:-26px;position:relative;z-index:3}
.kpi{background:var(--card);border-radius:14px;padding:16px 18px;border:1px solid var(--line);box-shadow:0 4px 18px rgba(13,33,55,.07);cursor:pointer;transition:.18s;border-top:3px solid transparent}
.kpi:hover{transform:translateY(-3px);box-shadow:0 10px 26px rgba(13,33,55,.13)}
.kpi.active{border-top-color:var(--gold);background:#fffdf7}
.kpi .n{font-size:31px;font-weight:700;line-height:1.1}
.kpi .l{font-size:13px;color:var(--muted);margin-top:2px}
.kpi .bar{height:5px;border-radius:4px;background:var(--line);margin-top:10px;overflow:hidden}
.kpi .bar i{display:block;height:100%;border-radius:4px}
.k-all .n{color:var(--navy)}.k-run .n{color:var(--run)}.k-stuck .n{color:var(--stuck)}.k-upd .n{color:var(--upd)}
.notice{margin-top:16px;background:linear-gradient(90deg,#fff9ec,#fff);border:1px solid #eddfba;border-inline-start:4px solid var(--gold);border-radius:12px;padding:12px 16px;display:flex;gap:12px;align-items:flex-start;font-size:13px}
.notice b{color:#8a6c1d}
.controls{display:flex;flex-wrap:wrap;gap:12px;align-items:center;margin:22px 0 16px}
.tabs{display:flex;background:#e8edf3;border-radius:11px;padding:4px;gap:3px;flex-wrap:wrap}
.tab{border:0;background:transparent;font-family:inherit;font-size:13.5px;font-weight:600;color:var(--muted);padding:8px 15px;border-radius:8px;cursor:pointer;transition:.15s}
.tab.active{background:#fff;color:var(--navy);box-shadow:0 2px 6px rgba(13,33,55,.1)}
.search{flex:1;min-width:190px;position:relative}
.search input{width:100%;padding:10px 40px 10px 14px;border:1px solid var(--line);border-radius:10px;font-family:inherit;font-size:14px;background:#fff;outline:none}
.search input:focus{border-color:var(--gold);box-shadow:0 0 0 3px var(--gold-soft)}
.search span{position:absolute;inset-inline-end:14px;top:50%;transform:translateY(-50%);color:var(--muted);font-size:14px}
.reset{border:1px solid var(--line);background:#fff;border-radius:10px;padding:9px 15px;font-family:inherit;font-size:13px;color:var(--muted);cursor:pointer}
.reset:hover{border-color:var(--gold);color:var(--navy)}
.deptsel{position:relative}
.deptsel select{appearance:none;padding:10px 34px 10px 14px;border:1px solid var(--line);border-radius:10px;font-family:inherit;font-size:13.5px;background:#fff;color:var(--ink);cursor:pointer;outline:none;max-width:290px}
.deptsel.on select{background:var(--navy);color:#fff;border-color:var(--navy);font-weight:600}
.deptsel::after{content:"▾";position:absolute;inset-inline-end:13px;top:50%;transform:translateY(-50%);pointer-events:none;font-size:11px;color:var(--muted)}
.deptsel.on::after{color:#fff}
.activefilters{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:10px}
.afchip{display:inline-flex;align-items:center;gap:7px;background:var(--gold-soft);border:1px solid #e4d3a6;color:#7d6118;border-radius:20px;padding:4px 12px;font-size:12px;font-weight:600}
.afchip button{border:0;background:#00000014;border-radius:50%;width:17px;height:17px;line-height:1;cursor:pointer;font-size:11px;color:#7d6118;font-family:inherit}
.sec-h{display:flex;align-items:center;gap:10px;margin:24px 0 13px;flex-wrap:wrap}
.sec-h h2{font-size:16.5px;font-weight:700;color:var(--navy)}
.sec-h .rule{flex:1;height:1px;background:var(--line);min-width:20px}
.sec-h .hint{font-size:12px;color:var(--muted);font-weight:400}
/* team cards */
.tgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(330px,1fr));gap:14px}
.tcard{background:var(--card);border:1px solid var(--line);border-radius:15px;padding:15px 17px;cursor:pointer;transition:.18s;position:relative;border-top:4px solid var(--line);display:flex;flex-direction:column;gap:10px}
.tcard:hover{transform:translateY(-3px);box-shadow:0 10px 26px rgba(13,33,55,.12);border-color:var(--gold)}
.tcard.s-run{border-top-color:var(--run)}.tcard.s-stuck{border-top-color:var(--stuck)}.tcard.s-upd{border-top-color:var(--upd)}
.tcard.k-national{background:linear-gradient(180deg,#f6f9fc,#fff)}
.tcard.k-unassigned{border-style:dashed;background:#fbfcfd}
.tc-top{display:flex;align-items:flex-start;gap:10px}
.tnum{background:var(--navy);color:#fff;border-radius:10px;min-width:34px;height:34px;display:grid;place-items:center;font-weight:700;font-size:14px;flex-shrink:0}
.tcard.k-national .tnum,.tcard.k-unassigned .tnum{background:#7d8ea3;font-size:15px}
.tc-title{font-size:14px;font-weight:600;line-height:1.55;flex:1}
.tc-ids{display:flex;flex-wrap:wrap;gap:4px;align-items:center}
.oid{display:inline-flex;align-items:center;background:var(--gold);color:var(--navy);border-radius:6px;padding:0 7px;font-size:10.5px;font-weight:700;white-space:nowrap}
.pill{font-size:11px;font-weight:600;padding:3px 11px;border-radius:20px;white-space:nowrap;display:inline-block}
.p-run{background:var(--run-bg);color:var(--run)}.p-stuck{background:var(--stuck-bg);color:var(--stuck)}.p-upd{background:var(--upd-bg);color:var(--upd)}
.who2{display:flex;flex-direction:column;gap:5px;font-size:12px}
.who2 .r{display:flex;gap:7px;align-items:flex-start}
.who2 .rb{background:var(--navy);color:#fff;border-radius:5px;font-size:10px;padding:1px 7px;flex-shrink:0;font-weight:600;margin-top:2px}
.who2 .rb.co{background:var(--gold-soft);color:#8a6c1d}
.who2 .rb.pend{background:var(--stuck-bg);color:var(--stuck)}
.tc-foot{display:flex;flex-wrap:wrap;gap:5px;align-items:center;border-top:1px dashed var(--line);padding-top:9px;margin-top:auto}
.tag{font-size:10.5px;padding:2px 8px;border-radius:6px;background:#eef2f7;color:#4a627c;font-weight:500}
.tag.chair{background:var(--navy);color:#fff}.tag.coord{background:var(--gold-soft);color:#8a6c1d}
.dchip{font-size:10px;padding:1px 7px;border-radius:6px;background:#eaf0f6;color:#4a627c;font-weight:500}
.tgt{font-size:11.5px;color:#41566d;background:#f7fafc;border-radius:9px;padding:8px 10px;line-height:1.6;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.tgt b{color:var(--muted);font-size:10.5px;display:block}
/* rows / kanban */
.acts{display:flex;flex-direction:column;gap:9px}
.act{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:12px 15px;cursor:pointer;transition:.15s;display:flex;gap:12px;align-items:flex-start;border-inline-start:4px solid var(--line)}
.act:hover{border-color:var(--gold);transform:translateX(-3px);box-shadow:0 5px 16px rgba(13,33,55,.08)}
.act.s-run{border-inline-start-color:var(--run)}.act.s-stuck{border-inline-start-color:var(--stuck)}.act.s-upd{border-inline-start-color:var(--upd)}
.anum{background:#eef2f7;color:var(--navy);font-weight:700;font-size:12px;border-radius:8px;min-width:30px;height:28px;display:grid;place-items:center;flex-shrink:0}
.abody{flex:1;min-width:0}.atitle{font-size:14px;font-weight:600;line-height:1.5}
.asub{font-size:11.5px;color:var(--muted);margin-top:3px;display:flex;flex-wrap:wrap;gap:3px 11px}
.aside{display:flex;flex-direction:column;align-items:flex-end;gap:6px;flex-shrink:0}
.arrow{color:#c3cedb;font-size:16px}
.kb{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:16px}
.col{background:#eaeff5;border-radius:14px;padding:13px}
.col h3{font-size:14px;font-weight:700;display:flex;align-items:center;gap:8px;margin-bottom:11px}
.col h3 .dot{width:9px;height:9px;border-radius:50%}
.col h3 .cnt{margin-inline-start:auto;background:#fff;border-radius:20px;padding:1px 10px;font-size:12px;color:var(--muted)}
.col .acts{gap:8px}.col .act{padding:11px 13px}
/* people & depts */
.people{display:grid;grid-template-columns:repeat(auto-fill,minmax(268px,1fr));gap:14px}
.pcard{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:15px 16px;cursor:pointer;transition:.18s;position:relative;overflow:hidden}
.pcard:hover{border-color:var(--gold);transform:translateY(-2px);box-shadow:0 8px 22px rgba(13,33,55,.1)}
.ptop{display:flex;align-items:center;gap:11px;margin-bottom:11px}
.av{width:42px;height:42px;border-radius:11px;display:grid;place-items:center;font-weight:700;font-size:15px;color:#fff;flex-shrink:0;background:var(--navy2)}
.av.unit{background:#7d8ea3;font-size:17px}
.pname{font-size:14.5px;font-weight:600;line-height:1.35}.prole{font-size:11.5px;color:var(--muted);line-height:1.4}
.ptot{margin-inline-start:auto;text-align:center;flex-shrink:0}
.ptot b{display:block;font-size:21px;font-weight:700;color:var(--navy);line-height:1}.ptot i{font-size:10px;color:var(--muted);font-style:normal}
.pbar{display:flex;height:7px;border-radius:5px;overflow:hidden;background:var(--line);margin-bottom:9px}.pbar i{display:block;height:100%}
.pmeta{display:flex;flex-wrap:wrap;gap:5px}
.dgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(232px,1fr));gap:10px}
.dcard{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:11px 13px;cursor:pointer;transition:.16s;display:flex;align-items:center;gap:10px}
.dcard:hover{border-color:var(--gold);transform:translateY(-2px);box-shadow:0 6px 18px rgba(13,33,55,.09)}
.dcard.on{border-color:var(--navy);background:#f7fafd;box-shadow:0 5px 16px rgba(13,33,55,.13)}
.dcard .ic{width:34px;height:34px;border-radius:9px;background:#eaf0f6;display:grid;place-items:center;font-size:15px;flex-shrink:0}
.dcard .dn{font-size:12.5px;font-weight:600;line-height:1.4}
.dcard .dbar{display:flex;height:5px;border-radius:4px;overflow:hidden;background:var(--line);margin-top:5px}.dcard .dbar i{display:block;height:100%}
.dcard .dc{font-size:18px;font-weight:700;color:var(--navy);flex-shrink:0}
/* linkage */
.alk{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px}
.alk .box{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:13px 15px;text-align:center}
.alk .box b{display:block;font-size:24px;font-weight:700;line-height:1.15}
.alk .box small{font-size:11.5px;color:var(--muted);display:block;margin-top:1px}
.alk .box .ring{height:5px;border-radius:4px;background:var(--line);margin-top:9px;overflow:hidden}.alk .box .ring i{display:block;height:100%;border-radius:4px}
.flowwrap{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:16px 16px 20px;position:relative;overflow:hidden}
.flowbar{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-bottom:12px;font-size:12px;color:var(--muted)}
.flowbar .lg{display:inline-flex;align-items:center;gap:5px}.flowbar .lg i{width:16px;height:4px;border-radius:3px;display:inline-block}
.flow{position:relative;display:grid;grid-template-columns:.9fr 1.5fr .9fr;gap:26px;align-items:start}
.flow svg{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:1;overflow:visible}
.fcol{position:relative;z-index:2;display:flex;flex-direction:column;gap:9px}
.fcol.side{justify-content:center;padding:26px 0}
.fcol>h4{font-size:12px;font-weight:700;color:var(--muted);text-align:center;padding-bottom:7px;border-bottom:2px solid var(--line);margin-bottom:3px}
.node{border:1px solid var(--line);background:#fff;border-radius:11px;padding:9px 11px;font-size:12.5px;line-height:1.5;cursor:pointer;transition:.16s;position:relative}
.node:hover{border-color:var(--gold);box-shadow:0 4px 14px rgba(13,33,55,.1)}
.node .nm{font-weight:600;display:block}.node .ns{font-size:10.5px;color:var(--muted)}
.node .cnt{position:absolute;top:8px;inset-inline-end:9px;background:#eef2f7;border-radius:20px;font-size:10.5px;padding:0 7px;color:var(--muted);font-weight:600}
.node.prog{background:linear-gradient(180deg,#f3f7fb,#fff);border-inline-start:4px solid var(--navy2)}
.node.ind{background:linear-gradient(180deg,#f7f4ec,#fff);border-inline-start:4px solid var(--gold)}
.node.act{border-inline-start:4px solid var(--line);padding-inline-end:34px}
.node.act.s-run{border-inline-start-color:var(--run)}.node.act.s-stuck{border-inline-start-color:var(--stuck)}.node.act.s-upd{border-inline-start-color:var(--upd)}
.node.none{border-style:dashed;color:var(--muted);background:#fafbfc}
.node .gapdot{position:absolute;top:9px;inset-inline-end:10px;width:8px;height:8px;border-radius:50%}
.flow.focused .node{opacity:.24;filter:grayscale(.6)}
.flow.focused .node.hi{opacity:1;filter:none;border-color:var(--gold);box-shadow:0 5px 16px rgba(200,162,74,.25)}
.flow.focused .node.pick{opacity:1;filter:none;border-color:var(--navy);box-shadow:0 6px 20px rgba(13,33,55,.22);transform:scale(1.02)}
.trace{background:var(--card);border:1px solid var(--line);border-radius:14px;overflow:auto}
table.tr{width:100%;border-collapse:collapse;font-size:12.5px;min-width:960px}
table.tr th{background:var(--navy);color:#fff;font-weight:600;font-size:11.5px;padding:10px 11px;text-align:right;position:sticky;top:0;vertical-align:bottom;line-height:1.45}
table.tr th.k{background:var(--navy2)}
table.tr td{padding:10px 11px;border-bottom:1px solid var(--line);vertical-align:top;line-height:1.6}
table.tr tr:hover td{background:#fffdf5;cursor:pointer}
.code{display:inline-block;background:#eef2f7;color:var(--navy);border-radius:6px;padding:1px 8px;font-weight:700;font-size:11.5px;white-space:nowrap;cursor:pointer}
.code.g{background:var(--gold-soft);color:#8a6c1d}.code.x{background:#f1f3f5;color:#9aa7b4;font-weight:500}.code.act{background:var(--navy);color:#fff}
.gapbadge{font-size:10.5px;font-weight:600;padding:2px 9px;border-radius:20px;white-space:nowrap}
.g-ok{background:var(--run-bg);color:var(--run)}.g-no{background:var(--upd-bg);color:var(--upd)}
.cellclip{max-width:250px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;color:#41566d}
.mini{font-size:11px;color:var(--muted)}
.linkfilters{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:12px}
.fchip{border:1px solid var(--line);background:#fff;border-radius:20px;padding:5px 13px;font-size:12px;font-family:inherit;cursor:pointer;color:#43586e;transition:.15s}
.fchip:hover{border-color:var(--gold)}.fchip.on{background:var(--navy);color:#fff;border-color:var(--navy)}
/* modal */
.ov{position:fixed;inset:0;background:rgba(11,26,43,.6);backdrop-filter:blur(3px);display:none;z-index:50;padding:20px;overflow-y:auto}
.ov.show{display:block}
.modal{max-width:880px;margin:32px auto;background:#fff;border-radius:18px;overflow:hidden;box-shadow:0 26px 70px rgba(0,0,0,.34);animation:pop .22s ease}
@keyframes pop{from{opacity:0;transform:translateY(16px) scale(.98)}}
.mhead{background:linear-gradient(135deg,var(--navy),var(--navy2));color:#fff;padding:22px 26px;position:relative}
.mhead .badge{display:inline-block;background:rgba(255,255,255,.13);border:1px solid rgba(255,255,255,.2);font-size:11.5px;padding:2px 11px;border-radius:20px;margin-bottom:9px}
.mhead h2{font-size:18.5px;font-weight:700;line-height:1.6;padding-inline-end:40px}
.mhead .mst{margin-top:11px;display:inline-flex;align-items:center;gap:7px;font-size:12.5px;font-weight:600;background:#fff;padding:4px 13px;border-radius:20px}
.close{position:absolute;top:18px;inset-inline-end:20px;background:rgba(255,255,255,.14);border:0;color:#fff;width:32px;height:32px;border-radius:9px;font-size:19px;cursor:pointer;line-height:1}
.close:hover{background:rgba(255,255,255,.26)}
.mbody{padding:22px 26px 26px}
.callout{background:var(--gold-soft);border-inline-start:4px solid var(--gold);border-radius:0 10px 10px 0;padding:13px 16px;margin-bottom:16px}
.callout b{display:block;font-size:11.5px;color:#8a6c1d;margin-bottom:4px;font-weight:700}
.callout p{font-size:14px;white-space:pre-line}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:13px}
.fld{background:#f8fafc;border:1px solid var(--line);border-radius:11px;padding:12px 14px}
.fld.full{grid-column:1/-1}
.fld b{display:block;font-size:11.5px;color:var(--muted);font-weight:600;margin-bottom:5px}
.fld p{font-size:13.5px;line-height:1.75}
.tasklist{list-style:none;counter-reset:tk;display:flex;flex-direction:column;gap:8px;margin-top:6px}
.tasklist li{counter-increment:tk;font-size:13.5px;line-height:1.8;padding-inline-start:32px;position:relative}
.tasklist li::before{content:counter(tk);position:absolute;inset-inline-start:0;top:3px;width:22px;height:22px;border-radius:7px;background:var(--navy);color:#fff;font-size:11px;font-weight:700;display:grid;place-items:center}
.complist{list-style:none;display:flex;flex-direction:column;gap:7px;margin-top:5px}
.complist li{display:flex;gap:9px;align-items:flex-start;font-size:13px;line-height:1.6}
.complist .rb{border-radius:6px;font-size:10px;padding:2px 8px;flex-shrink:0;font-weight:700;margin-top:3px;background:#eef2f7;color:#4a627c}
.complist .rb.ch{background:var(--navy);color:#fff}.complist .rb.co{background:var(--gold-soft);color:#8a6c1d}
.complist .rb.nt{background:var(--upd-bg);color:var(--upd)}
.empty{text-align:center;padding:40px 20px;color:var(--muted);font-size:14px;background:#fff;border:1px dashed var(--line);border-radius:14px}
.prov{background:var(--card);border:1px solid var(--line);border-radius:14px;overflow:hidden;margin-top:6px}
.prov .ph{padding:13px 17px;display:flex;align-items:center;gap:11px;cursor:pointer;background:linear-gradient(90deg,#f8fafc,#fff)}
.prov .ph h3{font-size:14.5px;font-weight:700;flex:1}
.prov .pb{padding:0 18px 16px;display:none}
.prov.open .pb{display:block}.prov.open .caret{transform:rotate(90deg)}
.caret{color:var(--muted);transition:.2s;display:inline-block;font-size:12px}
.tgroup{background:var(--card);border:1px solid var(--line);border-radius:14px;margin-bottom:12px;overflow:hidden}
.thead{padding:13px 17px;display:flex;align-items:center;gap:11px;cursor:pointer;background:linear-gradient(90deg,#f8fafc,#fff)}
.thead h3{font-size:14.5px;font-weight:700;flex:1}
.tmini{display:flex;gap:4px}.tmini i{width:22px;height:5px;border-radius:3px;display:block}
.tbody{padding:0 15px 14px;display:none}.tgroup.open .tbody{display:block}.tgroup.open .caret{transform:rotate(90deg)}
