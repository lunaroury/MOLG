  if(state.dec) af.push(`<span class="afchip">${state.dec==="صدر"?"✅ صدر قرار تكليف":state.dec==="لايلزم"?"◇ لا يلزم قرار جديد":"⏳ لم يصدر قرار بعد"}<button data-clr="dec">✕</button></span>`);
