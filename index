const decBadge=t=>{const d=t.decision||{},m=MODE(t);
  if(m==="frozen") return `<span class="dbadge" style="background:var(--frz-bg);color:var(--frz);border:1px solid #cfd8e3">⏸ قرار مجمّد</span>`;
  if(m==="issued"&&d.scope==="outside") return `<span class="dbadge d-out">⚠ قرار صادر خارج خطة اللامركزية</span>`;
  if(m==="issued"&&d.scope==="partial") return `<span class="dbadge d-part">◑ صدر قرار — يغطي جزءاً من الملف</span>`;
  const [c,l]=MODELBL[m]||MODELBL.pending;
  return `<span class="dbadge ${c}">${l}</span>`
    +(d.nationalRequest?`<span class="dbadge d-req">✉ طُلب تشكيل فريق وطني مشترك</span>`:"")
    +(d.first?`<span class="firstbadge">🥇 أول قرار صادر</span>`:"");};

/* filtering */
function matchQ(t){ if(!state.q) return true; const s=state.q.trim();
  return [t.title,t.short,t.theme,t.problem,t.target,t.partners,t.orgs,t.funding,t.update,t.statusRaw,
    ...t.activities,...t.tasks,...t.composition.map(c=>c.raw),...t.origIds,...t.planNums,
    ...Object.keys(t.roles),...Object.keys(t.depts)].join(" ").includes(s);}
const visible=()=>T.filter(t=>(state.status==="الكل"||t.status===state.status)&&
  (!state.dec||(state.dec==="صدر"?DEC_OK(t):state.dec==="لايلزم"?NO_NEED(t):AWAIT(t)))&&
  (!state.person||t.roles[state.person])&&inDept(t,state.dept)&&matchQ(t));

/* header + kpi */
