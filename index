let EDGES=[];
function drawFlow(){
  const flow=el("#flow"),svg=el("#fsvg"); if(!flow||!svg) return;
  const R=flow.getBoundingClientRect();
  svg.setAttribute("viewBox",`0 0 ${R.width} ${R.height}`); svg.setAttribute("width",R.width); svg.setAttribute("height",R.height);
  const pos=n=>{const e=flow.querySelector(`[data-n="${CSS.escape(n)}"]`); if(!e||e.style.display==='none') return null;
    const b=e.getBoundingClientRect(); return {L:{x:b.left-R.left,y:b.top-R.top+b.height/2},Rr:{x:b.right-R.left,y:b.top-R.top+b.height/2}};};
  EDGES=[];
  (window.__L||[]).forEach(t=>{const A=pos("A:"+t.id); if(!A) return; const col="var(--"+SK[t.status]+")";
    progOf(t).forEach(p=>{const P=pos("P:"+p); if(P) EDGES.push({from:"P:"+p,to:"A:"+t.id,a:P.L,b:A.Rr,col});});
    indOf(t).forEach(i=>{const I=pos("I:"+i); if(I) EDGES.push({from:"A:"+t.id,to:"I:"+i,a:A.L,b:I.Rr,col});});});
  svg.innerHTML=EDGES.map((e,k)=>{const mx=(e.a.x+e.b.x)/2;
    return `<path id="e${k}" d="M${e.a.x},${e.a.y} C${mx},${e.a.y} ${mx},${e.b.y} ${e.b.x},${e.b.y}" fill="none" stroke="${e.col}" stroke-width="1.6" opacity=".28" stroke-linecap="round"/>`;}).join("");
}
function applyFocus(){
  const flow=el("#flow"); if(!flow) return; const f=LSTATE.focus;
  flow.classList.toggle("focused",!!f);
  flow.querySelectorAll(".node").forEach(n=>n.classList.remove("hi","pick"));
  EDGES.forEach((e,k)=>{const p=el("#e"+k); if(p){p.setAttribute("opacity",f?(e.from===f||e.to===f?".95":".05"):".28");
    p.setAttribute("stroke-width",f&&(e.from===f||e.to===f)?"2.6":"1.6");}});
  if(!f) return;
  const pick=flow.querySelector(`[data-n="${CSS.escape(f)}"]`); if(pick) pick.classList.add("pick");
  EDGES.forEach(e=>{ if(e.from===f||e.to===f) [e.from,e.to].filter(x=>x!==f).forEach(x=>{
    const n=flow.querySelector(`[data-n="${CSS.escape(x)}"]`); if(n) n.classList.add("hi");});});
}
window.addEventListener("resize",()=>{ if(state.view==="link"){drawFlow();applyFocus();} });

/* events */
document.addEventListener("click",e=>{
  const clr=e.target.closest("[data-clr]");
  if(clr){const k=clr.dataset.clr; if(k==="status") state.status="الكل"; else if(k==="q"){state.q="";el("#q").value="";} else state[k]=null; LSTATE.focus=null; render(); return;}
  const jm=e.target.closest("[data-jump]");
  if(jm){e.stopPropagation(); LSTATE.focus=jm.dataset.jump; render(); const fl=el("#flow"); if(fl&&fl.scrollIntoView) fl.scrollIntoView({behavior:"smooth",block:"center"}); return;}
  const oc=e.target.closest("[data-only]");
  if(oc){LSTATE.only=oc.dataset.only==="all"?null:oc.dataset.only; LSTATE.focus=null; render(); return;}
  const dc=e.target.closest("[data-dept]");
  if(dc){state.dept=state.dept===dc.dataset.dept?null:dc.dataset.dept; state.person=null; LSTATE.focus=null; render(); return;}
  const nd=e.target.closest(".node");
  if(nd){const k=nd.dataset.n; if(k.startsWith("A:")&&LSTATE.focus===k) return openT(+nd.dataset.id);
         LSTATE.focus=LSTATE.focus===k?null:k; applyFocus(); return;}
  const tr=e.target.closest("table.tr tr[data-id]"); if(tr) return openT(+tr.dataset.id);
  if(e.target.closest(".flowwrap")&&!e.target.closest(".node")){LSTATE.focus=null; applyFocus(); return;}
  const card=e.target.closest(".tcard,.act,.upitem[data-id]"); if(card) return openT(+card.dataset.id);
  const pc=e.target.closest(".pcard"); if(pc){state.person=pc.dataset.p; state.view="people"; render(); try{window.scrollTo({top:280,behavior:"smooth"});}catch(_){} return;}
  const ph=e.target.closest(".ph,.thead"); if(ph) return ph.parentElement.classList.toggle("open");
  const bx=e.target.closest(".box[data-dec]");
  if(bx){ state.dec=state.dec===bx.dataset.dec?null:bx.dataset.dec; LSTATE.focus=null; render(); return;}
  const kp=e.target.closest(".kpi");
  if(kp){ if(kp.dataset.dec){ state.dec=state.dec===kp.dataset.dec?null:kp.dataset.dec; }
          else { state.status=kp.dataset.st; state.dec=null; }
          LSTATE.focus=null; render(); return;}
  const tb=e.target.closest(".tab"); if(tb){state.view=tb.dataset.v; LSTATE.focus=null; render(); return;}
  if(e.target.id==="ov") closeM();
});
el("#q").addEventListener("input",e=>{state.q=e.target.value; render();});
el("#dept").addEventListener("change",e=>{state.dept=e.target.value||null; LSTATE.focus=null; render();});
el("#reset").onclick=()=>{state={view:state.view,status:"الكل",person:null,dept:null,q:"",dec:null}; LSTATE={focus:null,only:null}; el("#q").value=""; el("#dept").value=""; render();};
document.addEventListener("keydown",e=>{if(e.key==="Escape") closeM();});
kpis(); render();

</script>
</body>
